# ===============================
# ROOT .gitignore (MERN Project)
# Place this in Team_Management_System/
# ===============================

# ---------- Dependencies ----------
node_modules/
**/node_modules/

# ---------- Logs ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment Files ----------
.env
.env.*
!.env.example

# ---------- Build / Dist ----------
dist/
build/
**/dist/
**/build/

# ---------- Vite ----------
frontend/.vite/
.vite/

# ---------- Coverage ----------
coverage/
*.lcov

# ---------- OS Files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- VS Code ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# ---------- JetBrains ----------
.idea/

# ---------- Temporary Files ----------
*.tmp
*.temp
*.swp
*.swo

# ---------- Runtime ----------
pids
*.pid
*.seed
*.pid.lock

# ---------- Cache ----------
.cache/
.parcel-cache/

# ---------- Uploads (if any) ----------
uploads/
public/uploads/

# ---------- Database Local Files ----------
*.sqlite
*.db

# ---------- Misc ----------
*.zip
*.rar